# AI Skill Gateway - Environment Configuration

# Application
APP_NAME="AI Skill Gateway"
APP_VERSION="1.0.0"
APP_HOST=127.0.0.1
APP_PORT=18080
DEBUG=false

# Docker Compose host ports
SERVER_PORT=18080
DB_PORT=15432
OLLAMA_PORT=11435
AUTH_API_KEY=dev-api-key

# AI Configuration
OLLAMA_HOST=http://localhost:11435
OLLAMA_MODEL=llama3.1:8b
EMBEDDING_MODEL=nomic-embed-text
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# Vector Database
VECTOR_DB_PATH=./data/vector_db
VECTOR_DB_COLLECTION=skills

# Storage - Local
LOCAL_STORAGE_PATH=C:/Skills
LOCAL_STORAGE_RECURSIVE=true

# Storage - PostgreSQL (Optional)
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=skills
POSTGRES_USER=admin
POSTGRES_PASSWORD=your_password_here
POSTGRES_ENABLED=false

# Storage - Google Drive (Optional)
GDRIVE_ENABLED=false
GDRIVE_CREDENTIALS_PATH=./config/gdrive-credentials.json
GDRIVE_FOLDER_ID=

# Memory
MEMORY_ENABLED=true
MEMORY_MAX_HISTORY=10
MEMORY_SIMILARITY_THRESHOLD=0.85

# Logging
LOG_LEVEL=INFO
LOG_PATH=./data/logs/gateway.log
